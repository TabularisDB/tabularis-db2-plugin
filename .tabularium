{
  "$schema": "https://registry.tabularis.dev/manifest.schema.json?kind=driver",
  "id": "db2",
  "name": "Db2",
  "version": "0.1.1",
  "description": "IBM Db2 driver for Tabularis over ODBC: browse schemas, tables, views and routines, edit rows with type-aware binding, generate DDL for tables, columns, indexes and foreign keys, and draw Visual EXPLAIN plans from Db2's explain tables.",
  "category": "database",
  "tags": [
    "driver",
    "db2",
    "ibm",
    "sql",
    "relational",
    "database-driver"
  ],
  "license": "Apache-2.0",
  "icon": "assets/icon.png",
  "screenshots": [
    {
      "url": "https://raw.githubusercontent.com/TabularisDB/tabularis-db2-plugin/master/assets/screenshots/01-schema-browser.png",
      "caption": "Schema browser with tables, views and routines",
      "alt": "Sidebar tree of a Db2 schema with tables, columns, keys, indexes, views and routines"
    },
    {
      "url": "https://raw.githubusercontent.com/TabularisDB/tabularis-db2-plugin/master/assets/screenshots/02-data-grid-pagination.png",
      "caption": "Paged data grid",
      "alt": "Data grid of a Db2 table with typed values and pagination"
    },
    {
      "url": "https://raw.githubusercontent.com/TabularisDB/tabularis-db2-plugin/master/assets/screenshots/03-sql-console.png",
      "caption": "SQL console",
      "alt": "SQL editor with a Db2 query and its result"
    },
    {
      "url": "https://raw.githubusercontent.com/TabularisDB/tabularis-db2-plugin/master/assets/screenshots/04-new-row.png",
      "caption": "Inserting a row",
      "alt": "Data grid with a new row being added"
    },
    {
      "url": "https://raw.githubusercontent.com/TabularisDB/tabularis-db2-plugin/master/assets/screenshots/05-inline-edit.png",
      "caption": "Inline cell editing",
      "alt": "Data grid with a cell being edited in place"
    },
    {
      "url": "https://raw.githubusercontent.com/TabularisDB/tabularis-db2-plugin/master/assets/screenshots/07-create-table.png",
      "caption": "Creating a table",
      "alt": "Create table dialog with Db2 column types"
    },
    {
      "url": "https://raw.githubusercontent.com/TabularisDB/tabularis-db2-plugin/master/assets/screenshots/08-modify-column.png",
      "caption": "Modifying a column",
      "alt": "Column editor generating ALTER TABLE and REORG statements"
    },
    {
      "url": "https://raw.githubusercontent.com/TabularisDB/tabularis-db2-plugin/master/assets/screenshots/09-edit-view.png",
      "caption": "Editing a view",
      "alt": "View editor with the view's query"
    },
    {
      "url": "https://raw.githubusercontent.com/TabularisDB/tabularis-db2-plugin/master/assets/screenshots/10-indexes.png",
      "caption": "Indexes",
      "alt": "Index list of a table, with columns and uniqueness"
    },
    {
      "url": "https://raw.githubusercontent.com/TabularisDB/tabularis-db2-plugin/master/assets/screenshots/11-foreign-key-details.png",
      "caption": "Foreign keys",
      "alt": "Foreign key details with referential actions"
    },
    {
      "url": "https://raw.githubusercontent.com/TabularisDB/tabularis-db2-plugin/master/assets/screenshots/12-routines.png",
      "caption": "Functions and procedures",
      "alt": "Routines grouped into functions and procedures, with parameters and a definition"
    },
    {
      "url": "https://raw.githubusercontent.com/TabularisDB/tabularis-db2-plugin/master/assets/screenshots/13-visual-explain.png",
      "caption": "Visual EXPLAIN",
      "alt": "Visual EXPLAIN of a Db2 join with costs, estimates and the hash join condition"
    }
  ],
  "color": "#2563eb",
  "readme": "README.md",
  "homepage": "https://github.com/TabularisDB/tabularis-db2-plugin",
  "documentation_url": "https://github.com/TabularisDB/tabularis-db2-plugin#readme",
  "min_runtime_version": "0.30.0",
  "support": {
    "issues_url": "https://github.com/TabularisDB/tabularis-db2-plugin/issues"
  },
  "kind": "driver",
  "engine": "db2",
  "paradigms": [
    "sql"
  ],
  "default_port": 50000,
  "default_username": "db2inst1",
  "executable": "tabularis-db2-plugin",
  "capabilities": {
    "schemas": true,
    "views": true,
    "routines": true,
    "explain": true,
    "file_based": false,
    "folder_based": false,
    "connection_string": true,
    "connection_string_example": "db2://user:pass@localhost:50000/sample",
    "identifier_quote": "\"",
    "sql_dialect": "generic",
    "sql_syntax": {
      "extends": "generic",
      "nested_block_comments": true,
      "script_blocks": true,
      "formatter": "db2",
      "keywords": [
        "FETCH FIRST",
        "ROWS ONLY",
        "OFFSET",
        "WITH UR",
        "WITH CS",
        "WITH RS",
        "WITH RR",
        "FOR READ ONLY",
        "FOR UPDATE",
        "OPTIMIZE FOR",
        "CURRENT DATE",
        "CURRENT TIME",
        "CURRENT TIMESTAMP",
        "CURRENT SCHEMA",
        "CURRENT USER",
        "CURRENT PATH",
        "CURRENT SERVER",
        "SET CURRENT SCHEMA",
        "SET CURRENT PATH",
        "GENERATED ALWAYS AS IDENTITY",
        "GENERATED BY DEFAULT AS IDENTITY",
        "GENERATED ALWAYS AS",
        "FOR BIT DATA",
        "NOT LOGGED INITIALLY",
        "ORGANIZE BY ROW",
        "ORGANIZE BY COLUMN",
        "MERGE",
        "WHEN MATCHED",
        "WHEN NOT MATCHED",
        "CALL",
        "VALUES",
        "DECLARE",
        "BEGIN ATOMIC",
        "END",
        "SIGNAL SQLSTATE",
        "LANGUAGE SQL",
        "DETERMINISTIC",
        "READS SQL DATA",
        "MODIFIES SQL DATA",
        "DYNAMIC RESULT SETS",
        "CREATE OR REPLACE",
        "RUNSTATS",
        "REORG TABLE",
        "EXPLAIN PLAN FOR",
        "COMMENT ON",
        "RENAME COLUMN",
        "SET DATA TYPE",
        "DROP NOT NULL",
        "SET NOT NULL",
        "SYSIBM.SYSDUMMY1"
      ],
      "functions": [
        "COALESCE",
        "NULLIF",
        "NVL",
        "DECODE",
        "VARCHAR",
        "CHAR",
        "INTEGER",
        "BIGINT",
        "DECIMAL",
        "DOUBLE",
        "DECFLOAT",
        "DATE",
        "TIME",
        "TIMESTAMP",
        "TIMESTAMP_FORMAT",
        "VARCHAR_FORMAT",
        "TO_CHAR",
        "TO_DATE",
        "TO_TIMESTAMP",
        "YEAR",
        "MONTH",
        "DAY",
        "HOUR",
        "MINUTE",
        "SECOND",
        "DAYOFWEEK",
        "DAYS",
        "MONTHS_BETWEEN",
        "ADD_MONTHS",
        "LAST_DAY",
        "TIMESTAMPDIFF",
        "LENGTH",
        "SUBSTR",
        "LOCATE",
        "POSSTR",
        "REPLACE",
        "TRANSLATE",
        "TRIM",
        "LTRIM",
        "RTRIM",
        "STRIP",
        "UPPER",
        "LOWER",
        "LPAD",
        "RPAD",
        "REPEAT",
        "CONCAT",
        "LISTAGG",
        "HEX",
        "ROW_NUMBER",
        "RANK",
        "DENSE_RANK",
        "LAG",
        "LEAD",
        "FIRST_VALUE",
        "LAST_VALUE",
        "ROUND",
        "TRUNCATE",
        "CEILING",
        "FLOOR",
        "MOD",
        "ABS",
        "SIGN",
        "POWER",
        "SQRT",
        "RAND",
        "GENERATE_UNIQUE",
        "IDENTITY_VAL_LOCAL",
        "XMLSERIALIZE",
        "XMLPARSE",
        "JSON_VALUE",
        "JSON_QUERY",
        "JSON_OBJECT",
        "JSON_ARRAY",
        "SYSTOOLS.BSON2JSON",
        "SYSTOOLS.JSON2BSON"
      ]
    },
    "alter_primary_key": false,
    "auto_increment_keyword": "",
    "serial_type": "",
    "inline_pk": false,
    "column_comments": true,
    "alter_column": true,
    "create_foreign_keys": true,
    "no_connection_required": false,
    "manage_tables": true,
    "readonly": false
  },
  "explain_parsers": [
    {
      "engine": "db2",
      "format": "db2-explain-tables-json",
      "label": "Db2 explain tables",
      "module": "explain/dist/index.iife.js"
    }
  ],
  "settings": [
    {
      "key": "driver_name",
      "label": "ODBC Driver Name",
      "type": "string",
      "default": "IBM DB2 ODBC DRIVER",
      "description": "ODBC driver name used in the Db2 connection string."
    },
    {
      "key": "security",
      "label": "Security Mode",
      "type": "select",
      "default": "none",
      "description": "Optional Db2 security mode.",
      "options": [
        "none",
        "ssl"
      ]
    },
    {
      "key": "current_schema",
      "label": "Default Schema",
      "type": "string",
      "default": "",
      "description": "Optional default schema set on each connection."
    },
    {
      "key": "extra_properties",
      "label": "Extra Connection Properties",
      "type": "string",
      "default": "",
      "description": "Semicolon-separated extra ODBC properties appended to the connection string."
    }
  ],
  "data_types": [
    {
      "name": "SMALLINT",
      "category": "numeric",
      "requires_length": false,
      "requires_precision": false,
      "supports_auto_increment": true
    },
    {
      "name": "INTEGER",
      "category": "numeric",
      "requires_length": false,
      "requires_precision": false,
      "supports_auto_increment": true
    },
    {
      "name": "BIGINT",
      "category": "numeric",
      "requires_length": false,
      "requires_precision": false,
      "supports_auto_increment": true
    },
    {
      "name": "DECIMAL",
      "category": "numeric",
      "requires_length": false,
      "requires_precision": true,
      "supports_auto_increment": false
    },
    {
      "name": "DECFLOAT",
      "category": "numeric",
      "requires_length": false,
      "requires_precision": false,
      "supports_auto_increment": false
    },
    {
      "name": "REAL",
      "category": "numeric",
      "requires_length": false,
      "requires_precision": false,
      "supports_auto_increment": false
    },
    {
      "name": "DOUBLE",
      "category": "numeric",
      "requires_length": false,
      "requires_precision": false,
      "supports_auto_increment": false
    },
    {
      "name": "CHAR",
      "category": "string",
      "requires_length": true,
      "requires_precision": false,
      "default_length": "1",
      "supports_auto_increment": false
    },
    {
      "name": "VARCHAR",
      "category": "string",
      "requires_length": true,
      "requires_precision": false,
      "default_length": "255",
      "supports_auto_increment": false
    },
    {
      "name": "CLOB",
      "category": "string",
      "requires_length": true,
      "requires_precision": false,
      "default_length": "1M",
      "supports_auto_increment": false
    },
    {
      "name": "GRAPHIC",
      "category": "string",
      "requires_length": true,
      "requires_precision": false,
      "default_length": "1",
      "supports_auto_increment": false
    },
    {
      "name": "VARGRAPHIC",
      "category": "string",
      "requires_length": true,
      "requires_precision": false,
      "default_length": "255",
      "supports_auto_increment": false
    },
    {
      "name": "DBCLOB",
      "category": "string",
      "requires_length": true,
      "requires_precision": false,
      "default_length": "1M",
      "supports_auto_increment": false
    },
    {
      "name": "DATE",
      "category": "date",
      "requires_length": false,
      "requires_precision": false,
      "supports_auto_increment": false
    },
    {
      "name": "TIME",
      "category": "date",
      "requires_length": false,
      "requires_precision": false,
      "supports_auto_increment": false
    },
    {
      "name": "TIMESTAMP",
      "category": "date",
      "requires_length": false,
      "requires_precision": false,
      "supports_auto_increment": false
    },
    {
      "name": "BLOB",
      "category": "binary",
      "requires_length": true,
      "requires_precision": false,
      "default_length": "1M",
      "supports_auto_increment": false
    },
    {
      "name": "BINARY",
      "category": "binary",
      "requires_length": true,
      "requires_precision": false,
      "default_length": "16",
      "supports_auto_increment": false
    },
    {
      "name": "VARBINARY",
      "category": "binary",
      "requires_length": true,
      "requires_precision": false,
      "default_length": "255",
      "supports_auto_increment": false
    },
    {
      "name": "BOOLEAN",
      "category": "boolean",
      "requires_length": false,
      "requires_precision": false,
      "supports_auto_increment": false
    },
    {
      "name": "XML",
      "category": "xml",
      "requires_length": false,
      "requires_precision": false,
      "supports_auto_increment": false
    }
  ]
}
