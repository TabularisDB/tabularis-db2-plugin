    "@tabularis/explain": "^0.2.0"
  },
  "devDependencies": {
    "@tabularis/explain": "file:tests/host",
    "@types/node": "^26.4.0",
    "tsup": "^9.0.0",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.23.0"
}
