{
  "name": "@tabularis/explain-db2",
  "version": "0.0.3",
  "private": true,
  "description": "IBM Db2 explain-table parser for Tabularis Visual EXPLAIN",
  "license": "Apache-2.0",
  "homepage": "https://github.com/TabularisDB/tabularis-db2-plugin/tree/master/explain",
  "repository": {
    "type": "git",
    "url": "https://github.com/TabularisDB/tabularis-db2-plugin.git",
    "directory": "explain"
  },
  "type": "module",
  "sideEffects": [
    "./dist/index.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
